{
  "id": "team-demo",
  "name": "Team demo",
  "type": "team",
  "version": "0.1.0",
  "pluginApi": "1",
  "description": "Demo team plugin.",
  "checksums": "checksums.txt",
  "contributes": {
    "roles": [
      {
        "id": "docs-writer",
        "name": {
          "en": "Docs writer",
          "ru": "Автор документации"
        },
        "description": {
          "en": "Writes docs.",
          "ru": "Пишет документацию."
        },
        "kind": "code",
        "placement": {
          "after": "tester"
        },
        "instructions": {
          "en": "roles/docs-writer.en.md",
          "ru": "roles/docs-writer.ru.md"
        },
        "permissions": {
          "read": "allow",
          "edit": "ask",
          "commands": {
            "default": "ask",
            "allow": [
              "git diff *"
            ]
          },
          "network": "deny"
        },
        "icon": "book"
      }
    ],
    "taskTypes": [
      {
        "id": "docs",
        "name": {
          "en": "Docs",
          "ru": "Документация"
        },
        "description": {
          "en": "Document a change.",
          "ru": "Описать изменение."
        },
        "roles": {
          "lead_intake": "on",
          "team-demo:docs-writer": "on",
          "reviewer": "on",
          "lead_accept": "on"
        },
        "branch": "new",
        "result": "code"
      }
    ]
  },
  "entry": {
    "darwin-arm64": {
      "asset": "arvel-plugin-godot-demo_darwin_arm64.tar.gz",
      "bin": "godot-mcp"
    },
    "darwin-amd64": {
      "asset": "arvel-plugin-godot-demo_darwin_amd64.tar.gz",
      "bin": "godot-mcp"
    },
    "linux-amd64": {
      "asset": "arvel-plugin-godot-demo_linux_amd64.tar.gz",
      "bin": "godot-mcp"
    },
    "linux-arm64": {
      "asset": "arvel-plugin-godot-demo_linux_arm64.tar.gz",
      "bin": "godot-mcp"
    },
    "windows-amd64": {
      "asset": "arvel-plugin-godot-demo_windows_amd64.zip",
      "bin": "godot-mcp.exe"
    },
    "windows-arm64": {
      "asset": "arvel-plugin-godot-demo_windows_arm64.zip",
      "bin": "godot-mcp.exe"
    }
  }
}
