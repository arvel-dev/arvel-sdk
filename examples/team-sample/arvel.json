{
  "$schema": "https://raw.githubusercontent.com/arvel-dev/arvel-sdk/main/schema/arvel.schema.json",
  "id": "team-sample",
  "name": "Team sample",
  "type": "team",
  "version": "0.1.0",
  "pluginApi": "1",
  "description": "One documentation role and the Docs task type; a template for team plugins.",
  "license": "MIT-0",
  "checksums": "checksums.txt",
  "contributes": {
    "roles": [
      {
        "id": "docs-writer",
        "name": { "en": "Docs writer", "ru": "Автор документации" },
        "description": {
          "en": "Writes and updates documentation under docs/ after the tests pass.",
          "ru": "Пишет и обновляет документацию в docs/ после прохождения тестов."
        },
        "kind": "code",
        "placement": { "after": "tester" },
        "instructions": { "en": "roles/docs-writer.en.md", "ru": "roles/docs-writer.ru.md" },
        "permissions": {
          "read": "allow",
          "edit": "ask",
          "commands": { "default": "ask", "allow": ["git diff *", "git log *"] },
          "network": "deny"
        },
        "icon": "book"
      }
    ],
    "taskTypes": [
      {
        "id": "docs",
        "name": { "en": "Docs", "ru": "Документация" },
        "description": {
          "en": "Document a change: intake, docs writer, review, acceptance.",
          "ru": "Описать изменение: разбор, автор документации, ревью, приёмка."
        },
        "roles": {
          "lead_intake": "on",
          "team-sample:docs-writer": "on",
          "reviewer": "on",
          "lead_accept": "on"
        },
        "branch": "new",
        "result": "code"
      }
    ]
  }
}
